# Node
node_modules/

# The maintainer's local AI-tooling libraries and their output stay out of the
# repository. Patterns are anchored to the root so .github/agents/, .github/skills/
# and .github/workflows/ are still tracked.
/agents/
/hooks/
/instructions/
/plugins/
/skills/
/workflows/
/reports/
/.claude/

# Local maintenance scripts stay ignored; the committed ones are listed explicitly.
/scripts/*
!/scripts/link-check.mjs

# Local environment and editor files
.env
.DS_Store
